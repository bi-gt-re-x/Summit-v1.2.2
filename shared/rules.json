{
  "_about": "Rules the browser and the server both apply, kept once. Read by backend/config/shared.py and imported in the browser as '@shared/rules.json'. Change a value here and both sides change; never copy one into code. shared/README.md says more.",

  "task_xp": {
    "min": 10,
    "max": 250,
    "medium_from": 80,
    "hard_from": 160,
    "bands": [
      { "from": 10, "label": "Easy" },
      { "from": 40, "label": "Light" },
      { "from": 80, "label": "Medium" },
      { "from": 120, "label": "Intermediate+" },
      { "from": 160, "label": "Hard" },
      { "from": 200, "label": "Very Challenging" }
    ]
  },

  "overdue": {
    "_about": "What finishing a task after its due date costs. Each day late takes cut_per_day of the task's XP, down to floor (a share of the full XP, never less than 1 XP). A date with no time is due by the end of that day. Tasks finished before since keep the full XP they were paid. backend/api/tasks.py charges it; frontend/src/utils/overdue.ts shows it.",
    "cut_per_day": 0.25,
    "floor": 0.25,
    "since": "2026-10-15"
  },

  "password": {
    "_about": "What a new password needs, checked on sign-up by backend/tracking/auth.py password_problem and listed live on the sign-up form (frontend/src/components/Auth/passwordRules.ts). Each rule is a regex the password must match, and its label is the line the form shows. Existing passwords aren't re-checked at log-in.",
    "min_length": 8,
    "max_length": 128,
    "rules": [
      { "key": "length", "label": "At least 8 characters", "pattern": "^[\\s\\S]{8,}$" },
      { "key": "upper", "label": "An uppercase letter", "pattern": "[A-Z]" },
      { "key": "lower", "label": "A lowercase letter", "pattern": "[a-z]" },
      { "key": "number", "label": "A number", "pattern": "[0-9]" },
      { "key": "symbol", "label": "A symbol (like ! or #)", "pattern": "[^A-Za-z0-9\\s]" }
    ]
  },

  "session_timing": {
    "_about": "When any planner books a session: a subject page (Plan my next session, Plan all), a dated goal (Book N sessions) or the skill tree (Plan a session), all through backend/api/booking.py. Sessions from every planner space around each other, and a goal's end by its deadline. Slots are scored on the reader's own record: how well work at that hour goes, how often they work then, how much of that weekday they usually work, how full the day already is, and how soon it is. Two sessions for the same subject never share a day, and are best gap_days apart by difficulty (1-5). backend/tracking/session_timing.py applies it.",
    "lookback_days": 120,
    "gap_days": { "1": 1, "2": 1, "3": 1, "4": 2, "5": 2 },
    "most_per_day": 2,
    "buffer_minutes": 15,
    "search_days": 14,
    "earliest_hour": 6,
    "latest_hour": 23
  },

  "grade_bands": [
    [100, "S"], [96, "A+"], [90, "A"], [80, "B"], [70, "C"], [60, "D"], [0, "F"]
  ],

  "time_spent": {
    "longest_block_seconds": 43200,
    "longest_sitting_seconds": 21600
  },

  "task_reasons": {
    "struggle": [
      { "key": "distracted", "label": "Could not focus", "phrase": "could not focus", "fix": "Put your phone in another room and set a 25-minute timer before you start" },
      { "key": "unclear", "label": "Did not know where to start", "phrase": "was unclear where to start", "fix": "Start with one worked example before you try one yourself" },
      { "key": "underestimated", "label": "Bigger than it looked", "phrase": "was bigger than it looked", "fix": "Split it into 15-minute pieces and book only the first" },
      { "key": "no-time", "label": "Ran out of time", "phrase": "ran out of time", "fix": "Book it earlier in the day, at half the size" },
      { "key": "low-energy", "label": "Low energy", "phrase": "was done on low energy", "fix": "Do it at the time of day you're sharpest" },
      { "key": "interrupted", "label": "Kept getting interrupted", "phrase": "kept getting interrupted", "fix": "Put it on the calendar as a block so the time is protected" }
    ],
    "went_well": [
      { "key": "prepared", "label": "Knew exactly what to do", "phrase": "was clear from the start" },
      { "key": "deep-focus", "label": "Had a clear run at it", "phrase": "had a clear run at it" },
      { "key": "momentum", "label": "Carried momentum in", "phrase": "carried momentum in" },
      { "key": "broken-down", "label": "Broken into small steps", "phrase": "was broken into small steps" },
      { "key": "fresh", "label": "Was fresh", "phrase": "was done fresh" },
      { "key": "familiar", "label": "Had done one like it", "phrase": "was familiar work" }
    ]
  },

  "recommendations": {
    "batch": 3,
    "max_steps": 6,
    "work_groups": 25,
    "step_types": ["targeted_practice", "mixed_practice", "timed_set", "review", "concept", "project"],
    "goal_kinds": ["exam", "competition", "mastery", "habit", "project", "coverage", "unstated"]
  },

  "spaces": {
    "count": 3,
    "name_max": 40,
    "body_max": 50000,
    "blocks_max": 1000,
    "block_text_max": 10000,
    "indent_max": 4,
    "icon_max": 16,
    "block_types": ["text", "h1", "h2", "h3", "bullet", "numbered", "todo", "toggle", "quote", "callout", "divider", "code", "chart", "sticky", "shape", "live", "container", "panel"],
    "covers": ["sunrise", "ocean", "meadow", "dusk", "ember", "forest", "slate", "sand"],
    "grid": { "cols": 12, "row_px": 8, "y_max": 5000 },
    "fill_styles": ["solid", "fade", "diagonal", "radial", "aurora", "flow"],
    "shapes": ["rectangle", "rounded", "circle", "triangle", "diamond", "star", "hexagon", "arrow"],
    "tall_rows": { "min": 6, "max": 120 },
    "cover_text_max": 80,
    "cover_aligns": ["left", "center", "right"],
    "chart": {
      "kinds": ["bar", "line", "area", "pie", "donut"],
      "points_min": 1,
      "points_max": 12,
      "label_max": 24,
      "scale_default": 100,
      "value_max": 1000000
    },
    "live": {
      "_about": "Live blocks: a space's page reading the account's own data. backend/tracking/live.py reads each source; frontend/src/components/Spaces/LiveBlock.tsx draws it. windows/weeks/ahead are the choices a block offers, in days or weeks. poll_ms is how often an open page asks whether anything changed.",
      "sources": ["goal", "goals", "records", "record", "calendar", "productivity", "growth", "skills", "heatmap", "rhythm", "subjects"],
      "groups": { "analytics": ["productivity", "growth", "skills", "heatmap", "rhythm", "subjects"], "goals": ["goal", "goals", "records", "record", "calendar"] },
      "views": {
        "goal": ["card", "ring", "timeline"],
        "goals": ["list", "bars", "rings"],
        "records": ["list", "bars", "table"],
        "record": ["line", "bars", "steps"],
        "calendar": ["list", "week"],
        "productivity": ["bars", "line", "area"],
        "growth": ["area", "line", "bars", "cumulative"],
        "skills": ["columns", "list", "accuracy", "ring"],
        "heatmap": ["grid", "strip"],
        "rhythm": ["weekday", "hour", "grid"],
        "subjects": ["donut", "pie", "bars"]
      },
      "metrics": {
        "productivity": ["xp", "tasks", "focus"],
        "growth": ["xp", "tasks"],
        "heatmap": ["xp", "tasks", "focus"],
        "rhythm": ["tasks", "xp"],
        "subjects": ["xp", "tasks"]
      },
      "heat_weeks": [12, 26, 52],
      "rhythm_days": [30, 90, 365],
      "goal_status": ["active", "all", "done"],
      "subjects_max": 8,
      "windows": [7, 30, 90],
      "weeks": [4, 8, 12],
      "ahead": [7, 14, 30],
      "limit_max": 12,
      "ref_max": 80,
      "calendar_max": 30,
      "poll_ms": 8000,
      "pick_max": 12,
      "record_sorts": ["recent", "improved", "tries", "name"]
    },
    "panels": {
      "_about": "Panel blocks: a panel from Analytics, the Timer or Achievements on a space's page, drawn by the page's own component from the account's live numbers. A block stores only `kind` and its settings. `fields` are the settings a kind can take; a kind's own entry names the ones it uses and may change a field's choices (`of`), limits or default. frontend/src/components/Spaces/panels.ts and backend/tracking/panels.py clean every saved block against this list, and shared/cases/space_panels.json pins the two together. docs/space-panels.md lists which Analytics panels are here.",
      "ref_max": 80,
      "groups": ["analytics", "suggest", "insights", "growth", "timer", "goals"],
      "fields": {
        "window": { "type": "choice", "of": ["7d", "30d", "90d", "1y", "2y", "all"], "default": "30d" },
        "period": { "type": "choice", "of": ["7d", "30d", "90d", "365d", "730d", "all"], "default": "30d" },
        "subject": { "type": "ref", "default": "" },
        "metric": { "type": "choice", "of": ["productivity", "consistency", "quality", "xp", "tasks", "focus"], "default": "productivity" },
        "grain": { "type": "choice", "of": ["daily", "weekly", "monthly"], "default": "weekly" },
        "range": { "type": "choice", "of": ["30", "90", "365"], "default": "365" },
        "limit": { "type": "count", "min": 1, "max": 12, "default": 5 },
        "budget": { "type": "choice", "of": [15, 30, 45, 60, 90, 120], "default": 45 },
        "days": { "type": "choice", "of": [1, 7, 30], "default": 1 },
        "show": { "type": "set", "of": [], "default": [] },
        "style": { "type": "choice", "of": [""], "default": "" },
        "category": { "type": "choice", "of": ["all", "Productivity", "Consistency", "Learning", "Mastery", "Milestones", "Analytics", "Special"], "default": "all" },
        "which": { "type": "choice", "of": ["earned", "next", "all"], "default": "earned" }
      },
      "kinds": {
        "summary": { "group": "analytics", "name": "Score and grade", "fields": {} },
        "tiles": { "group": "analytics", "name": "Headline numbers", "fields": { "window": {}, "show": { "of": ["productivity", "consistency", "quality", "tasks", "focus"], "default": ["productivity", "consistency", "quality", "tasks", "focus"] } } },
        "basics": { "group": "analytics", "name": "The basics", "fields": { "window": {}, "show": { "of": ["tasks", "focus", "xp", "streak", "completion"], "default": ["tasks", "focus", "xp", "streak", "completion"] } } },
        "trajectory": { "group": "analytics", "name": "Trend chart", "fields": { "window": { "default": "90d" }, "metric": {}, "grain": {} } },
        "heat": { "group": "analytics", "name": "Days worked", "fields": { "range": {} } },
        "subject-xp": { "group": "analytics", "name": "Where the work went", "fields": { "window": {}, "style": { "of": ["card", "line"], "default": "card" } } },
        "quality": { "group": "analytics", "name": "Quality", "fields": { "window": {}, "subject": {} } },
        "quality-grid": { "group": "analytics", "name": "How hard vs. how well", "fields": { "window": {}, "subject": {} } },
        "targets": { "group": "analytics", "name": "Your targets", "fields": { "window": {} } },
        "first-reads": { "group": "analytics", "name": "What your work says", "fields": {} },
        "goals-finished": { "group": "analytics", "name": "Goals finished", "fields": {} },
        "told-us": { "group": "analytics", "name": "What you told us", "fields": {} },
        "observations": { "group": "analytics", "name": "What's already true", "fields": { "limit": { "max": 6, "default": 2 } } },
        "stage": { "group": "analytics", "name": "What unlocks next", "fields": { "show": { "of": ["ladder", "next", "away", "note"], "default": ["ladder", "next", "away"] } } },
        "plan": { "group": "suggest", "name": "What to do next", "fields": { "budget": {}, "limit": { "max": 8, "default": 8 } } },
        "diagnosis": { "group": "suggest", "name": "What's going on", "fields": { "limit": { "max": 8, "default": 3 } } },
        "followup": { "group": "suggest", "name": "Changes you're trying", "fields": { "limit": {} } },
        "sessions": { "group": "suggest", "name": "Sessions to plan", "fields": {} },
        "coach": { "group": "suggest", "name": "What Summit knows", "fields": { "limit": { "max": 8, "default": 4 } } },
        "lens": { "group": "suggest", "name": "Why this order", "fields": { "style": { "of": ["card", "line"], "default": "card" } } },
        "xp-pulse": { "group": "suggest", "name": "XP pulse", "fields": { "window": {} } },
        "changed": { "group": "insights", "name": "What changed", "fields": { "limit": { "max": 9, "default": 4 } } },
        "habit-tiles": { "group": "insights", "name": "Habit numbers", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "habit-lead": { "group": "insights", "name": "Your habits, in short", "fields": { "window": { "default": "90d" }, "subject": {}, "style": { "of": ["card", "line"], "default": "card" } } },
        "habit-patterns": { "group": "insights", "name": "Habit patterns", "fields": { "window": { "default": "90d" }, "subject": {}, "limit": { "max": 8, "default": 4 } } },
        "habits": { "group": "insights", "name": "Habit cards", "fields": { "window": { "default": "90d" }, "subject": {}, "limit": { "default": 4 } } },
        "habit-steady": { "group": "insights", "name": "How steady each habit is", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "habit-timeline": { "group": "insights", "name": "When each habit began", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "say-do": { "group": "insights", "name": "Say vs. do", "fields": {} },
        "best-worst": { "group": "insights", "name": "Best and worst work", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "why": { "group": "insights", "name": "Why it went that way", "fields": { "window": { "default": "90d" }, "limit": { "max": 8, "default": 3 } } },
        "how": { "group": "insights", "name": "How you work", "fields": { "window": { "default": "90d" }, "subject": {}, "limit": { "max": 8, "default": 3 } } },
        "links": { "group": "insights", "name": "What goes with what", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "reasons": { "group": "insights", "name": "Your reasons", "fields": { "window": { "default": "90d" }, "subject": {} } },
        "clock": { "group": "insights", "name": "Hours you work", "fields": { "window": {}, "subject": {} } },
        "week": { "group": "insights", "name": "Days you work", "fields": { "window": {} } },
        "early-when": { "group": "insights", "name": "Time of day", "fields": { "window": {}, "subject": {} } },
        "finishes": { "group": "insights", "name": "How tasks end", "fields": {} },
        "follow-through": { "group": "insights", "name": "Follow-through", "fields": { "show": { "of": ["scores", "calendar", "planned", "depth", "stability", "trail", "recovery"], "default": ["scores", "planned", "depth", "recovery"] } } },
        "skills-chapter": { "group": "growth", "name": "Skills and subjects", "fields": {} },
        "goal-lines": { "group": "growth", "name": "Goals on your subjects", "fields": { "window": {} } },
        "tree-depth": { "group": "growth", "name": "How far into each tree", "fields": { "limit": { "default": 6 } } },
        "subject-opens": { "group": "growth", "name": "What each subject opens", "fields": { "window": {}, "limit": { "default": 6 } } },
        "skill-growth": { "group": "growth", "name": "Skill growth", "fields": { "period": {}, "limit": { "default": 6 } } },
        "skill-levels": { "group": "growth", "name": "Skills by level", "fields": { "limit": { "default": 6 } } },
        "time-progress": { "group": "growth", "name": "Time vs. progress", "fields": { "period": {} } },
        "skill-shape": { "group": "growth", "name": "Skill shape", "fields": {} },
        "growth-line": { "group": "growth", "name": "Growth timeline", "fields": { "period": { "default": "90d" }, "show": { "of": ["productivity", "consistency", "quality", "efficiency", "focus", "overall"], "default": ["productivity", "consistency", "quality", "efficiency"] } } },
        "then-now": { "group": "growth", "name": "Then and now", "fields": { "period": {} } },
        "movers": { "group": "growth", "name": "Biggest moves", "fields": { "period": {}, "show": { "of": ["best", "worst"], "default": ["best", "worst"] } } },
        "score-changes": { "group": "growth", "name": "What changed behind the scores", "fields": { "period": {} } },
        "periods": { "group": "growth", "name": "Growth by period", "fields": { "period": {} } },
        "milestones": { "group": "growth", "name": "Score milestones", "fields": { "period": { "default": "all" }, "limit": { "default": 6 } } },
        "core-hours": { "group": "growth", "name": "Core hours", "fields": { "window": {}, "subject": {} } },
        "years": { "group": "growth", "name": "Year by year", "fields": {} },
        "timer": { "group": "timer", "name": "Focus timer", "fields": { "show": { "of": ["task", "method"], "default": ["task"] } } },
        "timer-task": { "group": "timer", "name": "What you're working on", "fields": { "limit": { "max": 8, "default": 5 } } },
        "timer-today": { "group": "timer", "name": "Sessions by task", "fields": { "days": {} } },
        "timer-recent": { "group": "timer", "name": "Recent sessions", "fields": { "limit": { "default": 5 } } },
        "timer-suggest": { "group": "timer", "name": "Suggested length", "fields": {} },
        "timer-chart": { "group": "timer", "name": "Focus chart", "fields": { "days": { "of": [7, 14, 30], "default": 14 }, "metric": { "of": ["minutes", "sessions"], "default": "minutes" }, "style": { "of": ["bars", "area"], "default": "bars" } } },
        "badges": { "group": "goals", "name": "Badges", "fields": { "category": {}, "which": {}, "limit": { "default": 6 } } }
      }
    }
  },

  "background": {
    "_about": "The 'About you' answers from the last step of sign-up. How detailed they are decides the head start Analytics gives the account: days counted toward its unlock waits. A level needs at least `words` words in all and `answered` questions with `answered_words` or more; the first level that fits wins. backend/tracking/background.py and frontend/src/utils/background.ts both read this; shared/cases/background_detail.json pins them.",
    "questions": ["describe", "doing", "done", "improve"],
    "answered_words": 5,
    "max_chars": 2000,
    "levels": [
      { "key": "detailed", "label": "Very detailed", "words": 150, "answered": 4, "head_start": 7 },
      { "key": "good", "label": "Detailed", "words": 70, "answered": 3, "head_start": 4 },
      { "key": "brief", "label": "Brief", "words": 20, "answered": 1, "head_start": 2 },
      { "key": "none", "label": "Not filled in yet", "words": 0, "answered": 0, "head_start": 0 }
    ]
  },

  "log": {
    "_about": "The Log page: a private journal Summit learns from. Each saved entry is read by a model in the background and turned into short insights, each tagged with a kind. A passing feeling fades after `feeling_days` days and never becomes a lasting fact. `quiet_seconds` is how long an entry has to sit unchanged after an autosave before it's read; pressing Save reads it straight away. backend/tracking/journal.py and frontend/src/pages/Log.tsx both read this.",
    "title_max": 200,
    "body_max": 20000,
    "feeling_days": 7,
    "quiet_seconds": 45,
    "insights_max": 40,
    "kinds": [
      { "key": "goal", "label": "Long-term goal" },
      { "key": "pattern", "label": "Recurring pattern" },
      { "key": "preference", "label": "Preference" },
      { "key": "feeling", "label": "Passing feeling" }
    ],
    "topics": [
      { "key": "goals", "label": "Goals" },
      { "key": "interests", "label": "Interests" },
      { "key": "priorities", "label": "Priorities" },
      { "key": "motivation", "label": "Motivation" },
      { "key": "challenges", "label": "Challenges" },
      { "key": "preferences", "label": "Preferences" },
      { "key": "reflections", "label": "How you work" }
    ]
  }
}
