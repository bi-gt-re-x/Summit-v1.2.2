# Copy this file to `.env` (same folder) and fill in what you want to switch on.
# `.env` is read at startup by run.py and is git-ignored — never commit real keys.
# Everything here is optional: with none of it set the app still runs, verification
# links print to the server console, and the Google button stays hidden.

# --- Session signing -------------------------------------------------------
# Any long random string. Changing it signs everyone out.
SECRET_KEY=change-me-to-something-random

# --- Sending verification e-mail ------------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# It is 16 characters; paste it with or without spaces.
# Recipients can be on any provider — Gmail, Outlook, anything.
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=Summit <you@gmail.com>
# Defaults suit Gmail; Outlook/Office 365 is smtp.office365.com on port 587.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# --- Sign in with Google ---------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorised redirect URI: http://127.0.0.1:5050/auth/google/callback
# Copy the client ID and secret it shows you into these two lines.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The dashboard's daily quote ------------------------------------------
# Optional. Leave it blank and the quote comes from zenquotes.io, which needs
# no key — the feature works on a clean checkout either way. Set it to prefer
# api-ninjas.com (success/wisdom categories): sign up at api-ninjas.com and
# copy the key from your profile page.
# Never put this key in frontend code — the browser sends it in plain sight.
QUOTES_API_KEY=

# --- Breaking a goal into checkpoints -------------------------------------
# The "Suggest checkpoints" button on the goals page. With neither key set the
# button reports itself unavailable and the rest of the page works as normal.
#
# Hugging Face is the cheap option and the one tried first. Get a token at
# huggingface.co -> Settings -> Access Tokens -> New token; "read" is all it
# needs. The free tier covers a button pressed a few times a day.
HF_TOKEN=
# Which open model answers. The default is the cheapest that reliably works;
# a bigger one writes noticeably better checkpoints for very little more:
#   Qwen/Qwen2.5-7B-Instruct           (default)
#   meta-llama/Llama-3.1-8B-Instruct
#   Qwen/Qwen2.5-72B-Instruct
#   meta-llama/Llama-3.3-70B-Instruct
HF_MODEL=

# The better answers, on a paid account. Used when HF_TOKEN is unset, or when
# MILESTONE_PROVIDER below names it.
#
# This key also turns on the one other model-written thing in the app: the
# "Read this back to me" panel on a subject's analytics page, which takes the
# figures that page has already counted and writes what they mean and what to
# practise next. That one is Anthropic-only and does not fall back to Hugging
# Face — it asks a model to write over a table of your own statistics without
# adding any, and a small model inventing a number there would be worse than
# no panel. Without this key the panel is not drawn at all.
ANTHROPIC_API_KEY=

# Only for an identity-linked key — one that belongs to a person rather than
# to a workspace. Those are refused with a 400 until the request names the
# workspace it acts in; an ordinary key does not need this and ignores it.
# The id is in the console URL with the workspace open, and on
# Settings -> Workspaces.
#
# The alternative, and the tidier one: make an API key inside the workspace
# and put that in ANTHROPIC_API_KEY instead. A key that already belongs to a
# workspace needs no id, no header, and nothing on this line.
ANTHROPIC_WORKSPACE_ID=

# --- Grok (xAI) -----------------------------------------------------------
# The other paid option, and the newest. It drafts the same two things the
# button and the card ask for: a goal's five checkpoints, and the five small
# steps under one checkpoint.
#
# READ THE SPELLING. This is Grok, xAI's model, and it is NOT Groq, the free
# inference host configured by GROQ_API_KEY elsewhere in this file. The names
# differ by one letter and the app treats them as the two separate providers
# they are — a key in the wrong line is refused rather than silently used.
#
# Get a key at console.x.ai -> API Keys. XAI_API_KEY is the name xAI's own
# tools use and the one to prefer; GROK_API_KEY is accepted as well because it
# is what people type.
XAI_API_KEY=

# Which xAI model answers. Blank uses grok-4-fast, which is cheap, fast and
# strong enough for a five-item plan:
#   grok-4-fast    (default)
#   grok-4         better plans, several times the price, slower
#   grok-3-mini    cheapest, for simple goals
GROK_MODEL=

# How hard it is allowed to think, for the models that accept the setting:
# low or high. LEAVE THIS BLANK unless the model you named is documented to
# take it — grok-4 refuses the parameter outright and the request fails with a
# 400 rather than falling back.
GROK_REASONING=

# Pin which one runs: groq, huggingface, grok, anthropic — or leave blank to
# use whichever key is set, in that order (the free ones first, so an account
# with several keys is not billed for a button it could have free).
#
# "grok" and "groq" are matched exactly and never fall through to each other,
# so a typo here turns the feature off rather than quietly billing the other
# account.
MILESTONE_PROVIDER=

# --- Links in outgoing e-mail ---------------------------------------------
# The origin verification links point at. Set this when the port isn't 5050 or
# once the app is reachable somewhere other than this laptop.
APP_BASE_URL=http://127.0.0.1:5050

# --- Deployment switches ---------------------------------------------------
# All three default to the safe answer when unset, so an install that sets none
# of them is a *deployed* install. `python run.py` fills in the first two for a
# local run; nothing deployed should set them.

# Hand the e-mail verification link back to whoever asked for it, so the
# sign-up flow can be walked with no mail server. That is a token confirming an
# address the caller has not proven they own, so it is development only — see
# `dev_mode` in backend/config/settings.py.
SUMMIT_DEV=

# Drop the Secure flag on the session cookie, so it is sent over plain HTTP.
# Development is http://, and a Secure cookie is simply never sent there.
SUMMIT_INSECURE_COOKIES=

# Believe X-Forwarded-For. Turn this on only when something in front of the app
# is overwriting that header — on an app reachable directly it lets a caller
# spell a new IP on every request and walk past the rate limiter.
SUMMIT_TRUST_PROXY=
